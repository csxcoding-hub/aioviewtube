rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId
        && data.email is string && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000));
    }

    function isValidPlaylist(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.userId == userId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('loopMode' in data) || (data.loopMode in ['all', 'single', 'off']))
        && (!('itemCount' in data) || (data.itemCount is number));
    }

    function isValidPlaylistItem(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.playlistId is string && data.playlistId.size() <= 128
        && data.userId == userId
        && data.videoId is string && data.videoId.size() <= 32 && data.videoId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.title is string && data.title.size() <= 300
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000))
        && (!('channelTitle' in data) || (data.channelTitle is string && data.channelTitle.size() <= 200))
        && (!('order' in data) || (data.order is number));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isOwner(userId);

      match /playlists/{playlistId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPlaylist(incoming(), userId);
        allow update: if isOwner(userId) && isValidPlaylist(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().id == existing().id;
        allow delete: if isOwner(userId);

        match /items/{itemId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && isValidPlaylistItem(incoming(), userId);
          allow update: if isOwner(userId) && isValidPlaylistItem(incoming(), userId)
            && incoming().userId == existing().userId
            && incoming().playlistId == existing().playlistId;
          allow delete: if isOwner(userId);
        }
      }
    }
  }
}
